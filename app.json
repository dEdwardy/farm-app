{
  "expo": {
    "name": "渔场管家",
    "slug": "farm-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4CAF50"
    },
    "scheme": "farmapp",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*",
      "!docs/**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.edw4rd.farmapp",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "用于拍摄养殖场照片",
        "NSPhotoLibraryUsageDescription": "用于选择养殖场照片"
      }
    },
    "android": {
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#4CAF50",
        "foregroundImage": "./assets/images/icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.edw4rd.farmapp",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#4CAF50",
          "dark": {
            "backgroundColor": "#2E7D32"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许访问相册以上传养殖场照片",
          "cameraPermission": "允许使用相机拍摄养殖场照片"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ab8f9da4-a672-4009-9551-6253c169bb13"
      }
    },
    "owner": "edw4rd",
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
